  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "exclude": [
    "*.config.*",
    "generated"
  ],
}